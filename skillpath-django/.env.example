# Copy to .env and fill in. Never commit .env.

# Development: leave DEBUG on and the secret key can stay empty.
# Production: DJANGO_DEBUG=false, a long random DJANGO_SECRET_KEY, and your domain in the host lists.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=

# Google OAuth "Web application" client ID, used to verify Google sign-ins. It must match
# VITE_GOOGLE_CLIENT_ID in frontend/.env (which shows the button). Add http://localhost:8000 and
# http://127.0.0.1:8000 to the client's Authorized JavaScript origins in Google Cloud Console.
GOOGLE_CLIENT_ID=
